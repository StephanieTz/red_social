# ───────────────────────────────────────────────────────────────
# Copia este archivo a ".env" y completa los valores.
# ".env" NUNCA se sube a GitHub. Este archivo (.env.example) SÍ.
# ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# HTTPS=true solo si el sitio se sirve con https (activa cookie "secure").
HTTPS=false
# 1 si hay nginx delante de Node en la misma máquina (para ver la IP real del cliente)
TRUST_PROXY=0
# Solo si el frontend se sirviera desde otro dominio (normalmente vacío)
CORS_ORIGIN=

# Mínimo 32 caracteres aleatorios:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# PostgreSQL (Neon, RDS o el contenedor local de docker-compose)
DATABASE_URL=
DIRECT_URL=

# ── Almacenamiento de imágenes ──
# s3 = Amazon S3 (producción) · local = carpeta ./storage (desarrollo sin AWS)
STORAGE_DRIVER=s3
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
# En EC2 NO pongas claves: usa un IAM Role (ver infra/iam). Solo para probar S3 desde tu PC:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Rekognition (opcional): rostros, etiquetas y contenido inapropiado. Requiere permisos en el IAM Role.
REKOGNITION_ENABLED=false

# ── Google reCAPTCHA v2 ("No soy un robot") — https://www.google.com/recaptcha/admin ──
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# Claves de PRUEBA públicas de Google (solo desarrollo, siempre aprueban):
#   RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ── Google Login — https://console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth (Web) ──
# Orígenes autorizados: http://localhost:4000 y https://TU-DOMINIO
GOOGLE_CLIENT_ID=

MAX_UPLOAD_MB=10
