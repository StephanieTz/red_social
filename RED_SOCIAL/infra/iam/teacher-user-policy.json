{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerIniciarYDetenerEC2",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus", "ec2:StartInstances", "ec2:StopInstances", "ec2:DescribeAddresses"],
      "Resource": "*"
    },
    {
      "Sid": "VerBucketYDominio",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:ListBucket", "route53:ListHostedZones", "route53:ListResourceRecordSets"],
      "Resource": "*"
    }
  ]
}
